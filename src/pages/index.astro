---
import PlateMatesApp from '../components/AppSimulator.tsx';
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>PlateMates | Campus Secret Menu & Macro Tracker</title>
	</head>
	<body class="bg-slate-50 text-slate-900 font-sans">
		<!-- Navbar -->
		<nav class="fixed top-0 w-full bg-white/80 backdrop-blur-md z-50 border-b border-slate-100">
			<div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
				<div class="flex items-center gap-2">
					<span class="text-2xl font-black text-emerald-600 tracking-tighter italic">PLATEMATES</span>
				</div>
			<div class="hidden md:flex items-center gap-8 text-sm font-bold text-slate-600">
				<div class="relative group">
					<button
						type="button"
						class="flex items-center gap-1 hover:text-emerald-600 transition-colors"
					>
						<span>Features</span>
						<svg
							class="w-3 h-3 text-slate-400 group-hover:text-emerald-600 transition-colors"
							viewBox="0 0 20 20"
							fill="currentColor"
							aria-hidden="true"
						>
							<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.113l3.71-3.88a.75.75 0 111.08 1.04l-4.24 4.44a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
						</svg>
					</button>
					<div
						class="invisible opacity-0 group-hover:visible group-hover:opacity-100 absolute left-0 mt-3 w-40 bg-white border border-slate-100 rounded-xl shadow-lg py-2 text-sm text-slate-600 transition-opacity transition-visibility z-50"
					>
						<a
							href="#share"
							class="block px-4 py-2 hover:bg-emerald-50 hover:text-emerald-700"
						>
							Share
						</a>
						<a
							href="#filter"
							class="block px-4 py-2 hover:bg-emerald-50 hover:text-emerald-700"
						>
							Filter
						</a>
					</div>
				</div>

				<a href="#about" class="hover:text-emerald-600 transition-colors">About</a>
				<a href="/faq" class="hover:text-emerald-600 transition-colors">FAQ</a>
			</div>
				<a href="https://forms.office.com/r/QMBGCmQ4dF" target="_blank" class="bg-emerald-600 text-white px-6 py-2.5 rounded-full font-bold text-sm hover:bg-emerald-700 transition-all shadow-lg shadow-emerald-200">
					Join Waitlist
				</a>
			</div>
		</nav>

		<main>
			<!-- Hero Section -->
			<section id="share" class="pt-32 pb-20 px-6">
				<div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
					<div class="space-y-8">
						<div class="inline-block bg-emerald-100 text-emerald-700 px-4 py-1.5 rounded-full text-sm font-bold tracking-wide uppercase">
							🚀 Launching Soon at Towson University Dining Halls
						</div>
						<h1 class="text-5xl lg:text-7xl font-black text-slate-900 leading-[0.9] tracking-tighter italic uppercase">
							Stop Guessing.<br/>
							<span class="text-emerald-600">Start Gaining.</span>
						</h1>
						<p class="text-xl text-slate-600 max-w-xl leading-relaxed">
							The first community-driven campus dining hack app. Turn boring dining hall food into macro-perfect meals shared by your fellow students.
						</p>
					</div>

					<!-- App Preview Component -->
					<div class="relative">
						<div class="absolute -inset-4 bg-emerald-400/20 blur-3xl rounded-full"></div>
						<PlateMatesApp client:load />

						<!-- Pitch/Legend Floating Note -->
						<!-- <div class="hidden lg:block absolute -right-8 top-1/4 max-w-[240px] bg-white p-6 rounded-3xl shadow-2xl border border-emerald-100 transform rotate-3">
							<h3 class="font-black text-emerald-600 text-lg italic mb-2 uppercase">"Trust Me Bro"</h3>
							<p class="text-slate-600 text-xs leading-relaxed font-medium">
								Leverage campus social proof. If 10 gym rats verify a meal combo, that's better than any generic database entry.
							</p>
						</div> -->
					</div>
				</div>
			</section>

			<!-- Value Props -->
			<section id="features" class="py-20 bg-slate-900 text-white overflow-hidden">
				<div class="max-w-7xl mx-auto px-6">
					<div class="grid md:grid-cols-3 gap-12">
						<div class="space-y-4">
							<div class="w-12 h-12 bg-emerald-500 rounded-2xl flex items-center justify-center">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
							</div>
							<h3 class="text-2xl font-black italic uppercase tracking-tighter">Verified Macros</h3>
							<p class="text-slate-400 leading-relaxed">No more guessing. Get accurate macro-data for every item in your dining hall, sourced directly from campus inventory.</p>
						</div>
						<div class="space-y-4">
							<div class="w-12 h-12 bg-emerald-500 rounded-2xl flex items-center justify-center">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
							</div>
							<h3 class="text-2xl font-black italic uppercase tracking-tighter">Campus Hacks</h3>
							<p class="text-slate-400 leading-relaxed">Discover "The Sriracha Shred Bowl" or "Mediterranean Remix" - secret menu items created from standard dining hall staples.</p>
						</div>
						<div class="space-y-4">
							<div class="w-12 h-12 bg-emerald-500 rounded-2xl flex items-center justify-center">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							</div>
							<h3 class="text-2xl font-black italic uppercase tracking-tighter">Social Proof</h3>
							<p class="text-slate-400 leading-relaxed">Trust the community. Meals with "Verified Gains" badges are confirmed by other student-athletes on campus.</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer class="bg-white border-t border-slate-100 pt-16 pb-8 px-6">
			<div class="max-w-7xl mx-auto">
				<div class="grid md:grid-cols-4 gap-12 mb-12">
					<div class="col-span-2">
						<span class="text-2xl font-black text-emerald-600 tracking-tighter italic uppercase">PLATEMATES</span>
						<p class="mt-4 text-slate-500 max-w-xs leading-relaxed text-sm">
							Revolutionizing campus dining through community-driven meal hacking.
						</p>
					</div>
					<div>
						<h4 class="font-bold text-slate-900 mb-4 uppercase text-xs tracking-widest">Company</h4>
						<ul class="space-y-2 text-sm text-slate-500 font-medium">
							<li><a href="#about" class="hover:text-emerald-600 transition-colors">About</a></li>
							<li><a href="/faq" class="hover:text-emerald-600 transition-colors">FAQ</a></li>
							<li><a href="#" class="hover:text-emerald-600 transition-colors">Privacy</a></li>
						</ul>
					</div>
					<div>
						<h4 class="font-bold text-slate-900 mb-4 uppercase text-xs tracking-widest">Connect</h4>
						<ul class="space-y-2 text-sm text-slate-500 font-medium">
							<li><a href="#" class="hover:text-emerald-600 transition-colors">Instagram</a></li>
							<li><a href="#" class="hover:text-emerald-600 transition-colors">TikTok</a></li>
							<li><a href="#" class="hover:text-emerald-600 transition-colors">Twitter</a></li>
						</ul>
					</div>
				</div>
				<div class="border-t border-slate-50 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
					<p class="text-xs text-slate-400 font-medium">© 2024 PlateMates Inc. Built for the gains.</p>
					<div class="flex gap-6">
						<a href="#" class="text-xs text-slate-400 hover:text-emerald-600 transition-colors">Terms of Service</a>
						<a href="#" class="text-xs text-slate-400 hover:text-emerald-600 transition-colors">Privacy Policy</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
